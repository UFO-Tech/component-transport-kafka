{
    "name": "ufo-tech/component-transport-kafka",
    "description": "Kafka async transport resolver for the UFO JSON-RPC client SDK.",
    "authors": [
        {
            "name": "Valentyn Nikolaiev",
            "email": "valiknik225@gmail.com"
        }
    ],
    "type": "ufo-async-transport",
    "license": "MIT",
    "keywords": [
        "json-rpc",
        "sdk",
        "kafka",
        "async",
        "messenger"
    ],
    "homepage": "https://github.com/UFO-Tech/component-transport-kafka",
    "support": {
        "issues": "https://github.com/UFO-Tech/component-transport-kafka/issues",
        "source": "https://github.com/UFO-Tech/component-transport-kafka"
    },
    "require": {
        "php": ">=8.3",
        "ext-rdkafka": "*",
        "ufo-tech/component-transport-contracts": "^1.1",
        "ufo-tech/kafka-messenger": "^1.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Ufo\\Component\\AsyncKafkaTransport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ufo\\Component\\AsyncKafkaTransport\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "ufo-async-transport-builder": "Ufo\\Component\\AsyncKafkaTransport\\KafkaTransportConfigBuilder"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/UFO-Tech/kafka-messenger"
        }
    ]
}
